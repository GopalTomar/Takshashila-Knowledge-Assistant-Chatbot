# =============================================================================
# env.example — copy to .env for LOCAL use and fill in real values.
# Variable NAMES only; secrets are blank. NEVER commit .env. See DEPLOYMENT.md.
#
# Where each secret lives in production:
#
#   LOCAL ONLY (.env on your machine) ... anything below, for development
#
#   RENDER (service → Environment; the FastAPI backend + Mattermost bot)
#     secrets: GROQ_API_KEY, KB_BUNDLE_KEY, API_ACCESS_TOKENS,
#              MATTERMOST_BOT_TOKEN, MATTERMOST_SLASH_TOKEN, MATTERMOST_ACTION_SECRET
#     URL:     MATTERMOST_BOT_PUBLIC_URL=https://<render-service>.onrender.com
#     (non-secret settings such as MATTERMOST_URL, CORS_ALLOW_ORIGINS,
#      KB_BUNDLE_MANIFEST_URL, KB_LOW_MEMORY are pre-set in render.yaml)
#     NOT on Render: COMMIT_KB_USERNAME / COMMIT_KB_PASSWORD — the API never
#     crawls; it only downloads the encrypted bundle built by GitHub Actions.
#
#   GITHUB ACTIONS SECRETS (Settings → Secrets and variables → Actions → Secrets)
#     KB_BUNDLE_KEY, COMMIT_KB_USERNAME, COMMIT_KB_PASSWORD
#     (no GROQ_API_KEY or HF_TOKEN needed: the refresh smoke test is retrieval-only
#      and the embedding model is public)
#
#   PUBLIC / NON-SECRET (GitHub Actions *variable*, baked into the Pages site)
#     API_BASE_URL=https://<render-service>.onrender.com
# =============================================================================

# ── Local data location ───────────────────────────────────────────────────────
# Generated/private runtime data (KB releases ~340 MB each, crawl state, logs,
# reports). Use a local folder that is NOT synced by OneDrive/Dropbox/Google Drive:
#   Windows: DATA_DIR=C:/takshashila-data        Linux/macOS: DATA_DIR=~/takshashila-data
# Default (unset): <repo>/data. Render/Docker: /app/data (ephemeral on Render Free — the KB is re-downloaded on start).
# DATA_DIR=C:/takshashila-data
# Curated, git-tracked inputs (holiday list…). Default (unset): <repo>/data/knowledge_base.
# KB_INPUT_DIR=

# ── LLM (Groq) — API / Streamlit / Mattermost ──────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=45

# ── Embeddings / retrieval ───────────────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# sentence-transformers (default: indexing, local dev) | onnx (the Docker/Render image
# sets onnx + EMBEDDING_ONNX_DIR itself — same model exported to ONNX, no torch).
# EMBEDDING_BACKEND=sentence-transformers
# EMBEDDING_ONNX_DIR=
# EMBEDDING_THREADS=1
TOP_K=5
MIN_SCORE_THRESHOLD=0.35
CONF_HIGH_THRESHOLD=0.62
CONF_MEDIUM_THRESHOLD=0.48
SOURCE_PRIORITY_BOOST=0.12

# ── Citation verification ────────────────────────────────────────────────────
VERIFY_CITATIONS=true
GROUNDING_MIN_OVERLAP=0.18

# ── Chunking ─────────────────────────────────────────────────────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
CHUNK_MIN_LEN=60

# ── Commit KB (authenticated crawl) — refresh job only ───────────────────────
COMMIT_KB_URL=https://commit.takshashila.org.in/
COMMIT_KB_USERNAME=
COMMIT_KB_PASSWORD=

# ── Website crawl ────────────────────────────────────────────────────────────
WEBSITE_BASE_URL=https://takshashila.org.in/
# The site has ~1,000 pages + ~400 PDFs; keep the cap well above that. A crawl
# that hits the cap is reported as "partial" and removal detection is skipped.
WEBSITE_MAX_PAGES=5000
WEBSITE_MAX_DEPTH=8
WEBSITE_INCLUDE_PDFS=true
WEBSITE_MIN_TEXT_LEN=200
WEBSITE_OPED_LISTING_PATHS=/pages/news/
SCRAPE_MAX_RPS=4
SCRAPE_MAX_WORKERS=8
SCRAPE_TIMEOUT=30
SCRAPE_MAX_RETRIES=3
SCRAPE_DELAY=1.0
# CRAWLER_USER_AGENT=TakshashilaKnowledgeAssistant/2.0 (+https://takshashila.org.in/)

# ── Daily refresh (interpreted in KB_REFRESH_TIMEZONE — never UTC) ────────────
KB_REFRESH_ENABLED=true
KB_REFRESH_TIME=06:00
KB_REFRESH_TIMEZONE=Asia/Kolkata
KB_REFRESH_DEGRADED_AFTER=3
KB_MAX_FAILURE_RATIO=0.2
KB_REMOVAL_CONFIRMATIONS=2

# ── KB distribution (refresh job → API) ──────────────────────────────────────
# 32-byte key: python -m src.kb_bundle genkey   (same value in GitHub secret + Render)
KB_BUNDLE_KEY=
# e.g. https://github.com/<owner>/<repo>/releases/download/kb-latest/kb-manifest.json
KB_BUNDLE_MANIFEST_URL=
KB_BUNDLE_TOKEN=
KB_SYNC_INTERVAL_MINUTES=30
# true on 512 MB hosts (Render Free): swap KB releases without holding two in memory
KB_LOW_MEMORY=false

# ── Production API ───────────────────────────────────────────────────────────
# PORT is injected by Render; do not set it there.
# PORT=8000   (local only — never set on Render)
# Browser origins allowed to call the API (your GitHub Pages origin).
# Origins only (no path). Production: https://gopaltomar.github.io
# Local preview: add http://localhost:5500
CORS_ALLOW_ORIGINS=https://gopaltomar.github.io
# Comma-separated staff tokens that unlock internal sources (Commit KB) on /api/*.
API_ACCESS_TOKENS=
PUBLIC_SOURCES=website
INTERNAL_SOURCES=commit_kb,website,local,staff_handbook
API_RATE_LIMIT_PER_MINUTE=30
API_QUERY_TIMEOUT_SECONDS=60
LOG_QUERY_TEXT=false

# ── Streamlit admin (Build & Update / Automation tabs). Empty = hidden. ───────
ADMIN_PASSWORD=

# =============================================================================
# Mattermost bot (served by the same API at /mattermost/*)
# =============================================================================
MATTERMOST_URL=https://matter.takshashila.org.in
MATTERMOST_BOT_TOKEN=
MATTERMOST_SLASH_TOKEN=
# Public HTTPS base URL of the API (Render domain, https://<service>.onrender.com) — button/dialog callbacks.
MATTERMOST_BOT_PUBLIC_URL=
# Optional dedicated HMAC key for signing button/dialog callbacks
# (defaults to the slash token). Rotate together with the slash token.
MATTERMOST_ACTION_SECRET=
MATTERMOST_VOICE_SECRET=
MATTERMOST_RAG_TOP_K=5
MATTERMOST_RAG_TEMPERATURE=0.1
MATTERMOST_SEARCH_TOP_K=10
MATTERMOST_ALLOWED_TEAM_IDS=
MATTERMOST_ALLOWED_CHANNEL_IDS=
# Keep internal answers away from guest accounts / channels with guests (fails closed)
MATTERMOST_BLOCK_GUESTS=true
MATTERMOST_MAX_MESSAGE_CHARS=12000
MATTERMOST_WARM_RAG_ON_STARTUP=true
MATTERMOST_ANSWER_VISIBILITY=private
MATTERMOST_PRIVATE_DELIVERY=dm
MATTERMOST_ENABLE_ROUTING=true
MATTERMOST_ENABLE_GROUP=true
MATTERMOST_ENABLE_BUTTONS=true
MATTERMOST_ENABLE_SHARE_BUTTONS=true
MATTERMOST_ENABLE_PDF_EXPORT=true
MATTERMOST_ENABLE_VOICE=true
MATTERMOST_VOICE_TTL_SECONDS=1800
MATTERMOST_ENABLE_PROGRESS=true
